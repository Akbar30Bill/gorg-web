static func get_color(index: int) -> Color:
	var i := index * 3
	if i + 2 >= VGA_PALETTE.size():
		return Color.BLACK
	return Color(
		VGA_PALETTE[i] / 255.0,
		VGA_PALETTE[i + 1] / 255.0,
		VGA_PALETTE[i + 2] / 255.0,
		1.0
	)

static func indexed_to_rgba32(indexed: PackedByteArray, width: int, height: int) -> Image:
	var rgba := PackedByteArray()
	rgba.resize(width * height * 4)
	var out_idx := 0
	for i in indexed.size():
		var ci := indexed[i] * 3
		rgba[out_idx] = VGA_PALETTE[ci]
		rgba[out_idx + 1] = VGA_PALETTE[ci + 1]
		rgba[out_idx + 2] = VGA_PALETTE[ci + 2]
		rgba[out_idx + 3] = 255
		out_idx += 4
	var img := Image.create_from_data(width, height, false, Image.FORMAT_RGBA8, rgba)
	return img

static func indexed_to_rgba32_transparent(indexed: PackedByteArray, width: int, height: int, transparent_index: int = 255) -> Image:
	var rgba := PackedByteArray()
	rgba.resize(width * height * 4)
	var out_idx := 0
	for i in indexed.size():
		if indexed[i] == transparent_index:
			rgba[out_idx] = 0
			rgba[out_idx + 1] = 0
			rgba[out_idx + 2] = 0
			rgba[out_idx + 3] = 0
		else:
			var ci := indexed[i] * 3
			rgba[out_idx] = VGA_PALETTE[ci]
			rgba[out_idx + 1] = VGA_PALETTE[ci + 1]
			rgba[out_idx + 2] = VGA_PALETTE[ci + 2]
			rgba[out_idx + 3] = 255
		out_idx += 4
	var img := Image.create_from_data(width, height, false, Image.FORMAT_RGBA8, rgba)
	return img